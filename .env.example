DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=sqlite

# Optional: OpenRouter primary, Gemini secondary, OpenAI tertiary. Keys stay server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODEL=openrouter/free
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Set DB_ENGINE=mysql and these values if using MySQL instead of local SQLite.
MYSQL_DATABASE=finsight
MYSQL_USER=finsight
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
